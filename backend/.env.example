PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/society_security?schema=public"
JWT_ACCESS_SECRET=replace-with-very-strong-access-secret
JWT_REFRESH_SECRET=replace-with-very-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
